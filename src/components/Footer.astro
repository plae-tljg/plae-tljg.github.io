---
import { SITE, UI, type LocaleCode } from '../site.mjs'
import { archivePath, docsPath, projectsPath, withBase, writingPath } from '../lib/url'

interface Props {
  lang: LocaleCode
}

const { lang } = Astro.props
const t = UI[lang]
const year = new Date().getFullYear()
---

<footer class="site-footer">
  <div class="container site-footer__row">
    <p style="margin:0">© {year} {SITE.author} · {t.footerNote}</p>
    <p style="margin:0">
      <a href={writingPath(lang)}>{t.writing}</a>
      <span aria-hidden="true"> · </span>
      <a href={docsPath(lang)}>{t.docs}</a>
      <span aria-hidden="true"> · </span>
      <a href={projectsPath(lang)}>{t.projects}</a>
      <span aria-hidden="true"> · </span>
      <a href={archivePath(lang)}>{t.archive}</a>
      <span aria-hidden="true"> · </span>
      <a href={withBase(`/${lang}/rss.xml`)}>{t.rss}</a>
      <span aria-hidden="true"> · </span>
      <a href={SITE.github} rel="me noopener" target="_blank">GitHub</a>
    </p>
  </div>
</footer>
