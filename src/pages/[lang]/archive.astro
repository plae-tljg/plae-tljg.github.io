---
/**
 * The cross-section index: everything published here — articles, documentation
 * pages and older notes — newest first. This is what keeps the sections from
 * becoming silos.
 */
import { UI, type LocaleCode } from '../../site.mjs'
import { localePaths, tagPath } from '../../lib/url'
import BaseLayout from '../../layouts/BaseLayout.astro'
import EntryList from '../../components/EntryList.astro'
import { allTags, getPosts } from '../../lib/content'
import { getAllEntries } from '../../lib/entries'

export function getStaticPaths() {
  return localePaths()
}

const { lang } = Astro.params as { lang: LocaleCode }
const t = UI[lang]
const entries = await getAllEntries(lang)
const tags = allTags(await getPosts(lang))
const count = (kind: string) => entries.filter((e) => e.kind === kind).length
---

<BaseLayout lang={lang} title={t.archive} active="archive">
  <div class="container">
    <header class="page-header">
      <h1>{t.archive}</h1>
      <p>
        {
          lang === 'zh'
            ? `全站内容，按时间排列：文章 ${count('article')} 篇、文档 ${count('doc')} 页、旧文 ${count('note')} 篇。`
            : `Everything on the site by date: ${count('article')} articles, ${count('doc')} doc pages, ${count('note')} notes.`
        }
      </p>
    </header>

    <section class="section">
      <EntryList entries={entries} lang={lang} />
    </section>

    {
      tags.length > 0 && (
        <section class="section">
          <div class="section__head">
            <h2>{t.tags}</h2>
          </div>
          <p>
            {tags.map(({ tag, count: n }) => (
              <a class="tag" href={tagPath(lang, tag)}>
                {tag} <span style="color:var(--text-faint)">{n}</span>
              </a>
            ))}
          </p>
        </section>
      )
    }
  </div>
</BaseLayout>
