---
import { UI, type LocaleCode } from '../../site.mjs'
import { localePaths, tagPath } from '../../lib/url'
import BaseLayout from '../../layouts/BaseLayout.astro'
import PostList from '../../components/PostList.astro'
import { allTags, getPosts } from '../../lib/content'

export function getStaticPaths() {
  return localePaths()
}

const { lang } = Astro.params as { lang: LocaleCode }
const t = UI[lang]
const posts = await getPosts(lang)
const tags = allTags(posts)
---

<BaseLayout lang={lang} title={t.archive} active="archive">
  <div class="container">
    <header class="page-header">
      <h1>{t.archive}</h1>
      <p>
        {posts.length} {t.posts}
      </p>
    </header>

    <section class="section">
      {posts.length > 0 && <PostList posts={posts} lang={lang} />}
    </section>

    {
      tags.length > 0 && (
        <section class="section">
          <div class="section__head">
            <h2>{t.tags}</h2>
          </div>
          <p>
            {tags.map(({ tag, count }) => (
              <a class="tag" href={tagPath(lang, tag)}>
                {tag} <span style="color:var(--text-faint)">{count}</span>
              </a>
            ))}
          </p>
        </section>
      )
    }
  </div>
</BaseLayout>
