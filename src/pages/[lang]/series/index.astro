---
import { UI, type LocaleCode } from '../../../site.mjs'
import { localePaths } from '../../../lib/url'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import SeriesCard from '../../../components/SeriesCard.astro'
import { getSeriesViews } from '../../../lib/content'

export function getStaticPaths() {
  return localePaths()
}

const { lang } = Astro.params as { lang: LocaleCode }
const t = UI[lang]
const views = await getSeriesViews(lang)
---

<BaseLayout lang={lang} title={t.series} active="series">
  <div class="container">
    <header class="page-header">
      <h1>{t.allSeries}</h1>
      <p>{lang === 'zh' ? '按系列组织的长文。' : 'Long-form writing, grouped into series.'}</p>
    </header>

    <section class="section">
      <div class="card-grid">
        {
          views.map(({ series, posts }) => (
            <SeriesCard series={series} posts={posts} lang={lang} />
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>
