---
/**
 * Home: the three sections (writing, docs, projects) and what changed recently
 * across all of them — so no section is reachable only through its own tree.
 */
import { SITE, UI, LOCALES, type LocaleCode } from '../../site.mjs'
import {
  archivePath,
  docsPath,
  localePath,
  localePaths,
  projectsPath,
  writingPath,
} from '../../lib/url'
import BaseLayout from '../../layouts/BaseLayout.astro'
import Hero from '../../components/Hero.astro'
import EntryList from '../../components/EntryList.astro'
import { getRecentEntries, getSectionCounts } from '../../lib/entries'
import { repoStats } from '../../lib/repos'

export function getStaticPaths() {
  return localePaths()
}

const { lang } = Astro.params as { lang: LocaleCode }
const t = UI[lang]
const entries = await getRecentEntries(lang, 6)
const counts = await getSectionCounts(lang)
const repos = repoStats()
const alternates = Object.fromEntries(LOCALES.map((l) => [l.code, localePath(l.code)]))

const sections = [
  {
    key: 'writing',
    href: writingPath(lang),
    title: t.writing,
    description: t.sectionWriting,
    meta:
      lang === 'zh'
        ? `${counts.series} 个系列 · ${counts.articles} 篇`
        : `${counts.series} series · ${counts.articles} posts`,
  },
  {
    key: 'docs',
    href: docsPath(lang),
    title: t.docs,
    description: t.sectionDocs,
    meta:
      lang === 'zh'
        ? `${counts.tracks} 条路径 · ${counts.docs} 页`
        : `${counts.tracks} tracks · ${counts.docs} pages`,
  },
  {
    key: 'projects',
    href: projectsPath(lang),
    title: t.projects,
    description: t.sectionProjects,
    meta:
      lang === 'zh'
        ? `${repos.total} 个仓库 · ${repos.forks} 个 fork`
        : `${repos.total} repos · ${repos.forks} forks`,
  },
]
---

<BaseLayout lang={lang} title={SITE.title[lang]} alternates={alternates} active="home">
  <Hero>
    <h1>{SITE.title[lang]}</h1>
    <p>{SITE.tagline[lang]}</p>
    <div class="hero__links">
      <a class="btn" href={writingPath(lang)}>{t.writing}</a>
      <a class="btn btn--ghost" href={projectsPath(lang)}>{t.projects}</a>
    </div>
  </Hero>

  <section class="section">
    <div class="container">
      <div class="section-cards">
        {
          sections.map((section) => (
            <a class="section-card" href={section.href}>
              <h3>{section.title}</h3>
              <p>{section.description}</p>
              <div class="section-card__meta">{section.meta}</div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section__head">
        <h2>{t.latest}</h2>
        <a href={archivePath(lang)}>{t.viewAll} →</a>
      </div>
      {entries.length > 0 ? <EntryList entries={entries} lang={lang} showGroup={false} /> : <p>{t.emptyState}</p>}
    </div>
  </section>
</BaseLayout>
