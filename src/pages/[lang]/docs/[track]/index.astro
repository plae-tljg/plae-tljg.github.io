---
/**
 * A documentation track's landing page: hero, stages, and what is inside each.
 * The pages themselves come from the paths collection (synced from the writing
 * workspace).
 */
import { Image } from 'astro:assets'
import { LOCALES, TRACKS, UI, type LocaleCode } from '../../../../site.mjs'
import { docsPath, guidePath, stagePath, trackPath } from '../../../../lib/url'
import DocsLayout from '../../../../layouts/DocsLayout.astro'
import { heroFor } from '../../../../lib/assets'
import { getStageViews, isPreview } from '../../../../lib/content'
import '../../../../styles/path.css'

export async function getStaticPaths() {
  const paths = []
  for (const locale of LOCALES) {
    const lang = locale.code as LocaleCode
    for (const track of TRACKS) {
      const stages = await getStageViews(track.id, lang)
      paths.push({ params: { lang, track: track.id }, props: { track, stages } })
    }
  }
  return paths
}

const { track, stages } = Astro.props as {
  track: (typeof TRACKS)[number]
  stages: Awaited<ReturnType<typeof getStageViews>>
}
const lang = Astro.params.lang as LocaleCode
const t = UI[lang]
const hero = heroFor(track.id)
const stageMeta = (id: string) => (track.stages || []).find((s) => s.id === id)
---

<DocsLayout
  lang={lang}
  title={track.title[lang]}
  description={track.description[lang]}
  track={track.id}
>
  <div class="docs-page">
    <nav class="breadcrumb" style="margin-top:2rem">
      <a href={docsPath(lang)}>{t.docs}</a>
      <span aria-hidden="true">/</span>
      <span>{track.title[lang]}</span>
    </nav>
  </div>

  <section class="path-hero">
    <div class="container">
      <h1>{track.title[lang]}</h1>
      <p class="path-hero__subtitle">{track.subtitle[lang]}</p>

      {/* The joke image is Chinese-only, matching the source site. */}
      {
        hero && lang === 'zh' && (
          <Image
            class="path-hero__image"
            src={hero}
            alt={track.title[lang]}
            widths={[300, 600]}
            sizes="300px"
            loading="eager"
          />
        )
      }

      <div class="pet-gallery">
        {
          (track.hero?.pets || []).map((pet) => (
            <img
              class="pet-gif"
              src={`${import.meta.env.BASE_URL}paths/${pet}`.replace('//', '/')}
              alt=""
              loading="lazy"
              decoding="async"
            />
          ))
        }
      </div>

      <div class="nav-buttons">
        {
          stages.map((stage) => (
            <a
              class:list={['nav-btn', { primary: stage.id === track.stages?.[0]?.id }]}
              href={stagePath(lang, track.id, stage.id)}
            >
              {stageMeta(stage.id)?.title[lang]} →
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="docs-page">
      <div class="section__head">
        <h2>{t.browseStages}</h2>
      </div>

      {/* The stage cards are a summary; the list under each one means a reader
          who knows which page they want does not have to open the stage first. */}
      <div class="track-index">
        {
          stages.map((stage) => (
            <section class="track-index__stage">
              <h3>
                <a href={stagePath(lang, track.id, stage.id)}>
                  {stageMeta(stage.id)?.title[lang]}
                </a>
                <span class="track-index__count">
                  {stage.items.length + (stage.index ? 1 : 0)} {t.posts}
                </span>
              </h3>
              <p class="track-index__description">{stageMeta(stage.id)?.description[lang]}</p>
              <ul>
                {stage.index && (
                  <li>
                    <a href={stagePath(lang, track.id, stage.id)}>{stage.index.data.title}</a>
                  </li>
                )}
                {stage.items.map((page) => (
                  <li>
                    <a href={guidePath(lang, track.id, stage.id, page.data.slug)}>
                      {page.data.icon && <span aria-hidden="true">{page.data.icon} </span>}
                      {page.data.title}
                    </a>
                    {isPreview(page) && <span class="badge badge--warn">{t.preview}</span>}
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </div>
  </section>
</DocsLayout>
