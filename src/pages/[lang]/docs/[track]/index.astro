---
/**
 * A documentation track's landing page: hero, stages, and what is inside each.
 * The pages themselves come from the paths collection (synced from the writing
 * workspace).
 */
import { Image } from 'astro:assets'
import { LOCALES, TRACKS, UI, type LocaleCode } from '../../../../site.mjs'
import { docsPath, stagePath, trackPath } from '../../../../lib/url'
import BaseLayout from '../../../../layouts/BaseLayout.astro'
import { getStageViews } from '../../../../lib/content'
import heroImage from '../../../../assets/paths/math-path-hero.jpeg'
import '../../../../styles/path.css'

export async function getStaticPaths() {
  const paths = []
  for (const locale of LOCALES) {
    const lang = locale.code as LocaleCode
    for (const track of TRACKS) {
      const stages = await getStageViews(track.id, lang)
      paths.push({ params: { lang, track: track.id }, props: { track, stages } })
    }
  }
  return paths
}

const { track, stages } = Astro.props as {
  track: (typeof TRACKS)[number]
  stages: Awaited<ReturnType<typeof getStageViews>>
}
const lang = Astro.params.lang as LocaleCode
const t = UI[lang]
const stageMeta = (id: string) => (track.stages || []).find((s) => s.id === id)
---

<BaseLayout
  lang={lang}
  title={track.title[lang]}
  description={track.description[lang]}
  active="docs"
>
  <div class="container">
    <nav class="breadcrumb" style="margin-top:2rem">
      <a href={docsPath(lang)}>{t.docs}</a>
      <span aria-hidden="true">/</span>
      <span>{track.title[lang]}</span>
    </nav>
  </div>

  <section class="path-hero">
    <div class="container">
      <h1>{track.title[lang]}</h1>
      <p class="path-hero__subtitle">{track.subtitle[lang]}</p>

      {/* The joke image is Chinese-only, matching the source site. */}
      {
        lang === 'zh' && (
          <Image
            class="path-hero__image"
            src={heroImage}
            alt="这和坐牢有什么区别"
            widths={[300, 600]}
            sizes="300px"
            loading="eager"
          />
        )
      }

      <div class="pet-gallery">
        {
          (track.hero?.pets || []).map((pet) => (
            <img
              class="pet-gif"
              src={`${import.meta.env.BASE_URL}paths/${pet}`.replace('//', '/')}
              alt=""
              loading="lazy"
              decoding="async"
            />
          ))
        }
      </div>

      <div class="nav-buttons">
        {
          stages.map((stage) => (
            <a
              class:list={['nav-btn', { primary: stage.id === track.stages?.[0]?.id }]}
              href={stagePath(lang, track.id, stage.id)}
            >
              {stageMeta(stage.id)?.title[lang]} →
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section__head">
        <h2>{t.browseStages}</h2>
      </div>
      <div class="path-stages">
        {
          stages.map((stage) => (
            <a class="stage-card" href={stagePath(lang, track.id, stage.id)}>
              <h3>{stageMeta(stage.id)?.title[lang]}</h3>
              <p>{stageMeta(stage.id)?.description[lang]}</p>
              <div class="stage-card__meta">
                {stage.items.length + (stage.index ? 1 : 0)} {t.posts}
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
